# Copy to .env and fill in. Only one provider is needed.
# Groq free tier is sufficient to reproduce everything in this repo.
GROQ_API_KEY=
# Optional fallback, used only if GROQ_API_KEY is unset.
OPENAI_API_KEY=

# Optional overrides (defaults in src/hsa/config.py)
# HSA_GEN_MODEL=openai/gpt-oss-20b
# HSA_JUDGE_MODEL=qwen/qwen3.8-27b
# HSA_RETRIEVER=tfidf
